{
  "name": "embassy_mgt_system",
  "version": "1.0.0",
  "description": "Embassy Management System - Node.js/TypeScript/Express 5 + Prisma 7.9 + PostgreSQL backend for consular services",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx tsx src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "lint": "npx eslint src/**/*.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "npx jest"
  },
  "keywords": [
    "embassy",
    "consular",
    "management",
    "express",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/morgan": "^1.9.10",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "uuid": "^14.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.5",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "crypto-js": "^4.2.0",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2"
  }
}
