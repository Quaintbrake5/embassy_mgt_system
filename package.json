{
  "name": "embassy_mgt_system",
  "version": "1.0.0",
  "description": "Embassy Management System - Node.js/TypeScript/Express 5 + Prisma 7.9 + PostgreSQL backend for consular services",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx ts-node src/server.ts",
    "build": "npx tsc",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "lint": "npx eslint src/**/*.ts",
    "typecheck": "npx tsc --noEmit",
    "test": "npx jest"
  },
  "keywords": [
    "embassy",
    "consular",
    "management",
    "express",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.5",
    "@types/validator": "^13.12.2",
    "jest": "^29.7.0",
    "npx": "^10.2.2",
    "prisma": "^7.8.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}